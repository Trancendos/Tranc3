{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separatePatchReleases",
    "group:monorepos",
    "workarounds:all"
  ],
  "labels": [
    "dependencies",
    "automated"
  ],
  "reviewers": [
    "Trancendos"
  ],
  "assignees": [
    "Trancendos"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "prCreation": "immediate",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "platformAutomerge": false,
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "urgent"
    ],
    "automerge": true,
    "automergeType": "pr",
    "minimumReleaseAge": null,
    "description": "Security remediation is exempt from the 7-day supply-chain cooldown: the cooldown exists to let a compromised release be discovered before it is taken, and applying it to a published CVE fix would delay remediation for exactly as long."
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements",
        "poetry",
        "pep621"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Python patch updates",
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "pip_requirements",
        "poetry",
        "pep621"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Python minor updates",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Docker base image updates",
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Docker Compose service updates",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Node.js patch updates",
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false,
      "description": "Block ML library upgrades \u2014 require manual compatibility testing",
      "matchPackageNames": [
        "/^torch$/",
        "/^transformers$/",
        "/^sentence-transformers$/"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false,
      "description": "Block database major version upgrades \u2014 require migration planning",
      "matchPackageNames": [
        "/^postgres$/",
        "/^clickhouse$/"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": [
        "terraform",
        "opentofu"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "OpenTofu provider updates",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "AI frameworks (LangChain / LlamaIndex / Haystack / DSPy)",
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "labels": [
        "dependencies",
        "ai-framework"
      ],
      "matchPackageNames": [
        "/^langchain/",
        "/^llama-index/",
        "/^llama_index/",
        "/^farm-haystack$/",
        "/^haystack-ai$/",
        "/^dspy-ai$/",
        "/^dspy$/"
      ]
    },
    {
      "matchPackageNames": [
        "httpx"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "httpx",
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "description": "Only httpx remains here. fastapi/starlette/pydantic/uvicorn/redis are governed centrally by scripts/align_framework_pins.py and are disabled below; automerging them here would have pushed a 63-file framework pin change to main unreviewed."
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "GitHub Actions",
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "pinDigests": true
    },
    {
      "description": "Centrally governed pins \u2014 do not propose. These five are restated in 63 requirements files, so one version decision arrives as 63 identical line changes. scripts/align_framework_pins.py applies them in one reviewed pass and its CANONICAL dict is the single place the decision is made; any PR that moves some files without that script fails the Framework pin check in ci.yml and is unmergeable by construction. To bump one, edit CANONICAL and run with --write. Kept last so no later rule can re-enable it. Scoped to the pypi datasource so the redis Docker image still receives digest and patch updates.",
      "matchPackageNames": [
        "fastapi",
        "starlette",
        "pydantic",
        "uvicorn",
        "redis"
      ],
      "enabled": false,
      "matchDatasources": [
        "pypi"
      ],
      "minimumReleaseAge": null
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/dist/**",
    "**/build/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(\\.forgejo\\/workflows\\/.*\\.yml$|\\.woodpecker\\.yml$)/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>.+?)\\n.*?(?<currentValue>[\\d.]+)"
      ],
      "description": "Parse inline Renovate annotations in CI workflows"
    }
  ],
  "schedule": [
    "after 2am and before 6am on monday"
  ],
  "timezone": "Europe/London"
}
