# TRANC3 Web Frontend — Multi-stage build
FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS builder

WORKDIR /app
COPY web/package*.json ./
RUN npm ci --frozen-lockfile
COPY web/ .
RUN npm run build

FROM nginx:alpine@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913 AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Security: run as non-root user.
#
# /var/cache/nginx must be included. nginx creates its temp directories
# (client_temp, proxy_temp, fastcgi_temp, uwsgi_temp, scgi_temp) under it at
# startup, and in the base image it is owned by root — so without this the
# worker cannot mkdir client_temp and the container dies immediately with
# `[emerg] mkdir() "/var/cache/nginx/client_temp" failed (13: Permission
# denied)`. The image still builds cleanly, which is why this survived: nothing
# caught it until the container was actually started.
RUN chown -R nginx:nginx /usr/share/nginx/html /etc/nginx/conf.d /var/cache/nginx \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s \
    CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
