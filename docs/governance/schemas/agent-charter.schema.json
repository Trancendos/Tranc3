{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trancendos.com/schemas/agent-charter-v1.schema.json",
  "title": "Trancendos Agent Charter v1",
  "description": "Per-capability-class governance charter. See docs/governance/AI-GOVERNANCE-CONSTITUTION.md for the design this schema implements. Deliberately reuses existing platform vocabulary (RiskTier, IncidentSeverity from src/compliance/ai_governance.py) instead of inventing parallel enums.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "charter_id",
    "version",
    "tier",
    "domain",
    "mission",
    "allowed_actions",
    "forbidden_actions",
    "risk_tier",
    "approval_required",
    "escalation_triggers",
    "escalation_severity",
    "audit_sink",
    "fallback_behavior"
  ],
  "properties": {
    "charter_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$",
      "description": "Stable identifier for this charter, e.g. 'archprime-agent-readonly-retrieval'."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version. MAJOR = behavior/permission change, MINOR = new allowed action, PATCH = clarification only."
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "AeonMind tier per docs/governance/AI-GOVERNANCE-CONSTITUTION.md §1.2: 0=Human, 1=Orchestrator/Sovereign, 2=Prime, 3=AI/Lead AI, 4=Agent, 5=Bot."
    },
    "domain": {
      "type": "string",
      "enum": [
        "ArchPrime",
        "CommPrime",
        "CreatePrime",
        "DevPrime",
        "KnowPrime",
        "SecPrime",
        "WellPrime",
        "GovPrime",
        "OpsPrime",
        "unassigned"
      ],
      "description": "The PrimeDomain (t2ance/domain_authority.py) this charter's capability class sits under, or 'unassigned' for entities not yet mapped to a domain."
    },
    "mission": {
      "type": "string",
      "minLength": 1,
      "description": "One-sentence description of the narrow capability class this charter governs."
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "risk_tier": {
      "type": "string",
      "enum": ["unacceptable", "high", "limited", "minimal"],
      "description": "Reuses ai_governance.RiskTier (EU AI Act Annex III / Art. 6) — not a new risk vocabulary."
    },
    "approval_required": {
      "type": "boolean",
      "description": "When true, actions under this charter must clear CAB Gate (src/compliance/cab_gate.py, MC-RULE-007) before executing."
    },
    "escalation_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "confidence_below_threshold",
          "policy_conflict",
          "sensitive_data_detected",
          "irreversible_action_requested",
          "external_communication",
          "production_change",
          "prompt_injection_suspected",
          "audit_gap"
        ]
      }
    },
    "escalation_severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Reuses ai_governance.IncidentSeverity — not a separate 5-level scheme."
    },
    "audit_sink": {
      "type": "string",
      "const": "observatory",
      "description": "The Observatory is the platform's one real audit log. This field exists for future extensibility, not because a choice exists today."
    },
    "fallback_behavior": {
      "type": "string",
      "enum": ["stop_and_escalate", "ask_human", "defer", "refuse"],
      "description": "What happens when this charter's rules don't clearly cover the situation. Default posture is stop_and_escalate, matching Magna Carta's human-agency principle (ambiguity escalates, never defaults permissive)."
    },
    "confidence_model": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required whenever escalation_triggers contains confidence_below_threshold (see the top-level if/then below) — ties that trigger to AeonMind's real Intelligence Score weights instead of a bare threshold with no scoring behind it. Once present, threshold and all five weights are mandatory: a partial model is rejected rather than silently treated as unconstrained.",
      "required": ["threshold", "weights"],
      "properties": {
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision_quality",
            "adaptation_speed",
            "state_coherence",
            "resource_efficiency",
            "communication"
          ],
          "properties": {
            "decision_quality": { "type": "number", "minimum": 0, "maximum": 1 },
            "adaptation_speed": { "type": "number", "minimum": 0, "maximum": 1 },
            "state_coherence": { "type": "number", "minimum": 0, "maximum": 1 },
            "resource_efficiency": { "type": "number", "minimum": 0, "maximum": 1 },
            "communication": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "escalation_triggers": {
            "contains": { "const": "confidence_below_threshold" }
          }
        },
        "required": ["escalation_triggers"]
      },
      "then": { "required": ["confidence_model"] }
    },
    {
      "if": { "required": ["confidence_model"] },
      "then": {
        "properties": {
          "escalation_triggers": {
            "contains": { "const": "confidence_below_threshold" }
          }
        },
        "required": ["escalation_triggers"]
      }
    }
  ],
  "examples": [
    {
      "charter_id": "archprime-agent-readonly-retrieval",
      "version": "1.0.0",
      "tier": 4,
      "domain": "ArchPrime",
      "mission": "Retrieve and summarize approved internal documents for The Spark / The Digital Grid.",
      "allowed_actions": ["read_approved_documents", "summarize_sources"],
      "forbidden_actions": ["access_restricted_data", "execute_write_actions", "external_communication"],
      "risk_tier": "limited",
      "approval_required": false,
      "escalation_triggers": ["confidence_below_threshold", "sensitive_data_detected"],
      "escalation_severity": "medium",
      "audit_sink": "observatory",
      "fallback_behavior": "stop_and_escalate",
      "confidence_model": {
        "threshold": 0.5,
        "weights": {
          "decision_quality": 0.30,
          "adaptation_speed": 0.25,
          "state_coherence": 0.20,
          "resource_efficiency": 0.15,
          "communication": 0.10
        }
      }
    }
  ]
}
