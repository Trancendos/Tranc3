{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trancendos read-only evidence metadata v0.2",
  "type": "object",
  "required": [
    "source",
    "id",
    "name"
  ],
  "additionalProperties": true,
  "properties": {
    "source": {
      "enum": [
        "gdrive",
        "github"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "content_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "authored_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "modified_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_required": {
      "type": "boolean"
    }
  }
}
