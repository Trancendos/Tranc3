{
  "charter_id": "opsprime-agent-infra-readonly",
  "version": "1.0.0",
  "tier": 4,
  "domain": "OpsPrime",
  "mission": "Read-only infrastructure monitoring for The Citadel and The Observatory.",
  "allowed_actions": [
    "read_health_status",
    "summarize_incident_log",
    "query_deployment_state"
  ],
  "forbidden_actions": [
    "restart_service",
    "modify_deployment",
    "access_secrets",
    "production_change"
  ],
  "risk_tier": "high",
  "approval_required": true,
  "escalation_triggers": [
    "production_change",
    "irreversible_action_requested"
  ],
  "escalation_severity": "high",
  "audit_sink": "observatory",
  "fallback_behavior": "stop_and_escalate"
}
