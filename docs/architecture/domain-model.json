  "associations": [
    {
      "name": "LocationHasSeats",
      "owner": "Location",
      "target": "RoleSeat",
      "multiplicity": "1-*",
      "required": true,
      "description": "Each Location defines the seats that are its module roles."
    },
    {
      "name": "SeatHeldByAI",
      "owner": "RoleSeat",
      "target": "AI",
      "multiplicity": "1-1",
      "required": false,
      "description": "Mutable at runtime via the Role Assignment Registry."
    },
    {
      "name": "ContainerCustodiedBy",
      "owner": "Container",
      "target": "Location",
      "multiplicity": "1-*",
      "required": true,
      "description": "Always The Ice Box. Required: a container with no custodian is the one case the shared-jurisdiction model exists to prevent."
    },
    {
      "name": "ContainerUnderJurisdictionOf",
      "owner": "Container",
      "target": "Location",
      "multiplicity": "1-*",
      "required": false,
      "description": "Whose code runs inside. Optional on purpose: 86 containers are third-party images running nobody's code here."
    },
    {
      "name": "DatastoreOwnedBy",
      "owner": "Datastore",
      "target": "Location",
      "multiplicity": "1-*",
      "required": false,
      "description": "114 are currently unrouted and await a Town Hall decision."
    },
    {
      "name": "ContainerRunsDatastore",
      "owner": "Container",
      "target": "Datastore",
      "multiplicity": "1-*",
      "required": false,
      "description": "A file-backed store inside a container's writable layer dies with the container unless a volume is mounted. This edge is what makes that answerable per store rather than per service."
    },
    {
      "name": "LocationDependsOnLocation",
      "owner": "Location",
      "target": "Location",
      "multiplicity": "*-*",
      "required": false,
      "description": "The dependency graph blast radius is computed over."
    }
  ],
